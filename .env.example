# ==============================================================================
# CodeSage AI — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real API keys to version control.
# ==============================================================================

# ── Required API Keys ─────────────────────────────────────────────────────────
# Get your Google Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend Configuration ─────────────────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
MAX_CODE_SIZE_BYTES=32768
LOG_LEVEL=INFO

# ── Database & Storage ────────────────────────────────────────────────────────
# In Docker Compose, the backend connects to the mongodb service container.
# For standalone local run, use: mongodb://localhost:27017
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=codesage

# ChromaDB persistence directory and collection name
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=coding_guidelines

# ── RAG & Retrieval Engine ───────────────────────────────────────────────────
RAG_ENABLED=true
RAG_N_RESULTS=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Networking & CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ── Frontend Configuration ───────────────────────────────────────────────────
# Base URL for API requests originating from the browser
VITE_API_BASE_URL=http://localhost:8000
